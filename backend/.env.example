# ─────────────────────────────────────────────────────────────
#  ChatWithMe — Backend Environment Variables
#  Copy this file to .env and fill in your actual values.
#  cp .env.example .env
# ─────────────────────────────────────────────────────────────

################# Azure OpenAI — Chat Model ##################
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_api_key
AZURE_OPENAI_API_VERSION=2025-04-14
AZURE_OPENAI_CHAT_DEPLOYMENT=your_chat_deployment_name

################# Azure OpenAI — Embeddings ##################
# If your embeddings model is on the SAME Azure resource as
# the chat model, you can reuse AZURE_OPENAI_ENDPOINT above.
AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT=text-embedding-3-small
api_version=2024-02-01

################# Supabase ###################################
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_service_role_key

################# (Optional) GitHub Models ###################
# Uncomment and configure if using GitHub-hosted OpenAI models
# OPENAI_API_KEY=your_openai_api_key
# OPENAI_BASE_URL=https://models.inference.ai.azure.com

################# (Optional) Google Generative AI ############
# Uncomment and configure if using Google AI models
# GOOGLE_API_KEY=your_google_api_key
# GOOGLE_EMBEDDING_MODEL=models/embedding-001
# GOOGLE_CHAT_MODEL=models/gemini-2.0-flash
